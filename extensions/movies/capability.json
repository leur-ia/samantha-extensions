              "movie",
              "series"
            ]
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "class": "read",
      "data": "web",
      "merge": {
        "list": "results"
      },
      "route": [],
      "ids": [
        "id"
      ]
    },
